# Where the browser calls drill-down-api. Unset it to fall back to the same-origin /api proxy,
# which is what lets one ngrok tunnel serve the whole app.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Only if that proxy should target something other than localhost:8080.
# API_PROXY_TARGET=

# Chat websocket. Next rewrites do not proxy websockets, so this needs its own reachable host.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Serve mock data instead of calling the API.
NEXT_PUBLIC_USE_MOCKS=false

# Public; matches the backend GOOGLE_CLIENT_ID. The SSO button hides when unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
